# Claude API key for the AI features (campaign brief, Brand Studio, Operations Copilot).
# Without it, each panel streams a clearly labelled offline sample, so the demo still works.
ANTHROPIC_API_KEY=

# Supabase gives cross-device realtime (phone -> laptop), needed for the judge demo.
# It is used automatically when the URL and key are set. Without them the app runs on an
# in-browser mock that only syncs tabs in one browser. Set NEXT_PUBLIC_DATA_SOURCE=mock to force the mock.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_DATA_SOURCE=mock

# Server-only code used to reset the live demo from the admin screen.
# Use a memorable, presentation-only passcode; never expose the service-role key.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_RESET_SECRET=

# Optional: origin baked into the /demo QR code (defaults to the current origin).
# Set to the Vercel production URL so the printed QR never points at localhost.
NEXT_PUBLIC_SITE_URL=
