# Claude API key for the live AI campaign brief (/routines). Without it, the panel
# streams a clearly labelled offline sample, so the demo still works.
ANTHROPIC_API_KEY=

# "mock" (default): no backend, live updates sync across tabs in one browser.
# "supabase": cross-device realtime (phone -> laptop). Needed for the judge demo.
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only code used to reset the live demo from the admin screen.
# Use a memorable, presentation-only passcode; never expose the service-role key.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_RESET_SECRET=

# Optional: origin baked into the /demo QR code (defaults to the current origin).
# Set to the Vercel production URL so the printed QR never points at localhost.
NEXT_PUBLIC_SITE_URL=
